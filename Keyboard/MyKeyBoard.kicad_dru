
(version 1)

# ============================================================
# 01. DEFAULT - 通常の基板端クリアランス
# ============================================================

(rule "Default edge clearance"
    (constraint edge_clearance (min 0.50mm))
)


# ============================================================
# 02. SK6812MINI-E - LED埋め込み用
# 対象：D5000番台のパッド
# ============================================================

(rule "SK6812MINI-E edge clearance"
    (constraint edge_clearance (min 0.20mm))
    (condition "A.Type == 'Pad' && A.memberOfFootprint('D5*')")
)


# ============================================================
# 03. LIS2DTW12TR - LGA-12パッド間
# 対象：AC7001 / AC7101
# ============================================================

(rule "LGA-12 pad clearance"
    (constraint clearance (min 0.15mm))
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && ((A.memberOfFootprint('AC7001') && B.memberOfFootprint('AC7001')) || (A.memberOfFootprint('AC7101') && B.memberOfFootprint('AC7101')))")
)


# ============================================================
# 04. PMW3610 - センサー開口部
# 対象：U6101
# ============================================================

(rule "PMW3610 edge clearance"
    (constraint edge_clearance (min 0.35mm))
    (condition "A.Type == 'Pad' && A.memberOfFootprint('U6101')")
)
